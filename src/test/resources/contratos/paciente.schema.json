{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paciente",
  "type": "object",
  "required": ["rut", "nombre", "fechaNacimiento", "prevision", "convenioEmpresa"],
  "additionalProperties": false,
  "properties": {
    "rut":             { "type": "string", "minLength": 1, "maxLength": 15 },
    "nombre":          { "type": "string", "minLength": 1, "maxLength": 120 },
    "fechaNacimiento": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "prevision":       { "type": "string", "enum": ["FONASA", "ISAPRE", "PARTICULAR"] },
    "tramoFonasa":     { "type": ["string", "null"], "enum": ["A", "B", "C", "D", null] },
    "convenioEmpresa": { "type": "boolean" }
  }
}
